# Skopiuj do pliku .env i uzupełnij.

# Hasło do bazy danych (dowolne, długie)
DB_PASSWORD=zmien-to-haslo

# Konto administratora tworzone przy PIERWSZYM uruchomieniu
ADMIN_LOGIN=admin
ADMIN_PASSWORD=zmien-to-haslo-admina

# Port, na którym aplikacja będzie dostępna w sieci lokalnej (http://serwer:8080)
APP_PORT=8080

# Adres, pod którym użytkownicy otwierają aplikację (np. http://192.168.1.10:8090).
# Trafia jako link do opisu wydarzeń w Kalendarzu Google. Bez końcowego ukośnika.
APP_URL=

# Ustaw true, jeśli aplikacja działa za HTTPS (reverse proxy z certyfikatem)
COOKIE_SECURE=false

# Maksymalny rozmiar załącznika w MB
MAX_UPLOAD_MB=20

# Integrację z Kalendarzem Google konfiguruje się w aplikacji: Administracja → Integracje.
